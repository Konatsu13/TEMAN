# Copy this file to .env in the repository root for the Vite frontend.
# These VITE_* values are public and are included in the browser bundle.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"

# Optional fallback domain for deterministic username-to-email auth when Edge Function is not deployed
VITE_AUTH_EMAIL_DOMAIN="teman.local"

# Used by the Edge Function when running locally with:
# supabase functions serve ai-query --env-file .env
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
APP_URL="http://localhost:3000"

# The server-side Gemini key/model above are shared by ai-query and chat-ai.
# Never rename them with a VITE_ prefix.

# Set VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, and VAPID_SUBJECT as Edge Function secrets.
# Never put the VAPID private key in a VITE_* variable or frontend bundle.
